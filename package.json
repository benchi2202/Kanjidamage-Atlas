{
  "name": "kanjidamage-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive atlas for telling KanjiDamage kanji apart by shape, component, and pronunciation.",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:all": "npm run data:fetch && npm run data:build && npm run data:validate",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "d3": "7.9.0",
    "fflate": "^0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
